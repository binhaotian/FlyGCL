graph TD
    %% FlyPrompt online_evaluate call graph.
    %% Read top to bottom: main entry -> trainer loop -> FlyPrompt hook -> model layer -> leaves.

    subgraph L0[入口层 / Entry]
        M0[main.py\n解析 CLI 参数]
        M1[methods.METHODS["flyprompt"]\n构建 FlyPrompt trainer]
        M2[_Trainer.run()\n进入训练主循环]
    end

    subgraph L1[训练器层 / Trainer]
        T1[_Trainer.main_worker()\n构建数据、模型、循环]
        T2[达到 eval_period\n触发周期评估]
        T3[任务结束 / epoch 结束\n触发任务末评估]
        T4[online_evaluate(...)\n调用子类评估钩子]
        T5[归约 + 日志\n分布式汇总评估结果]
    end

    subgraph L2[FlyPrompt 方法层 / methods.flyprompt.FlyPrompt]
        F1[online_evaluate()\n评估入口]
        F2[model_without_ddp.update()\n先刷新 RP 路由器]
        F3[forward_with_rp(x)\n用 RP 选 expert]
        F4[argmax(logit_raw)\n得到 expert_ids]
        F5[forward_with_ema(x, expert_ids)\n按 expert 做多头推理]
        F6[_ensemble_logits(...)\n融合 online/EMA 多头输出]
        F7[_interpret_pred(y, pred)\n统计每类正确数]
    end

    subgraph L3[模型层 / models.flyprompt.FlyPrompt]
        P1[FlyPrompt.update()\n委托给 RPFC.update]
        P2[FlyPrompt.forward_with_rp()\nbackbone + RPFC]
        P3[FlyPrompt.forward_with_ema()\nbackbone + prompt experts + EMA heads]
        P4[FlyPrompt.collect()\n训练时累计 RP 统计]
    end

    subgraph L4[叶子实现 / Leaf Functions]
        R1[RPFC.update()\n(G + ridge I)^-1 Q\n闭式求解路由器权重]
        R2[RPFC.forward()\n随机投影 + 线性层]
        R3[Prompt.forward()\n把 prompt 插入 ViT 多层]
        R4[RPFC.collect()\n累计 G/Q 统计量]
        R5[Prompt.init_new_expert()\n新 expert 用旧 prompt 均值 warm start]
        R6[init_fc()\n初始化新 expert 的分类头]
    end

    M0 --> M1 --> M2
    M2 --> T1
    T1 --> T2 --> T4
    T1 --> T3 --> T4
    T4 --> F1
    F1 --> F2 --> P1 --> R1
    F1 --> F3 --> P2 --> R2
    F3 --> F4
    F1 --> F5 --> P3 --> R3
    F5 --> F6
    F6 --> F7
    F1 --> T5

    %% Training-side dependency that makes evaluation possible.
    P4 --> R4
    R4 --> R1

    %% Internal step growth used during training, not evaluation, but tightly coupled.
    P4 -.-> R5
    P4 -.-> R6

    classDef entry fill:#f8fafc,stroke:#334155,stroke-width:2px;
    classDef trainer fill:#eff6ff,stroke:#2563eb,stroke-width:2px;
    classDef method fill:#eef2ff,stroke:#6366f1,stroke-width:2px;
    classDef model fill:#fff7ed,stroke:#f59e0b,stroke-width:2px;
    classDef leaf fill:#ecfdf5,stroke:#10b981,stroke-width:2px;

    class M0,M1,M2 entry;
    class T1,T2,T3,T4,T5 trainer;
    class F1,F2,F3,F4,F5,F6,F7 method;
    class P1,P2,P3,P4 model;
    class R1,R2,R3,R4,R5,R6 leaf;
